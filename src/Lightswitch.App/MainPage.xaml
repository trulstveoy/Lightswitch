<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lightswitch.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lightswitch.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Text="Lightswitch" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusText, Mode=OneWay}" />
        </StackPanel>

        <ToggleSwitch
            Grid.Row="1"
            Header="Power"
            IsOn="{Binding IsOn, Mode=TwoWay}" />

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="Brightness" />
            <Slider
                Maximum="100"
                Minimum="0"
                StepFrequency="1"
                Value="{Binding Brightness, Mode=TwoWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding Brightness, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="Color temperature" />
            <Slider
                Maximum="6500"
                Minimum="2700"
                StepFrequency="100"
                Value="{Binding TemperatureKelvin, Mode=TwoWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding TemperatureKelvin, Mode=OneWay}" />
        </StackPanel>

        <ToggleSwitch
            Grid.Row="4"
            Header="Start with Windows"
            IsOn="{Binding StartWithWindows, Mode=TwoWay}" />
    </Grid>
</Page>
