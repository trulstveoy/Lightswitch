<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lightswitch.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lightswitch.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    Title="Lightswitch"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Lightswitch">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Frame x:Name="RootFrame" Grid.Row="1" />

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            Grid.RowSpan="2"
            IconSource="Assets/AppIcon.ico"
            LeftClickCommand="{x:Bind ShowWindowCommand}"
            MenuActivation="RightClick"
            NoLeftClickDelay="True"
            ToolTipText="Lightswitch">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Click="OpenMenuItem_Click" Text="Open" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="TogglePowerMenuItem_Click" Text="Toggle power" />
                    <MenuFlyoutSubItem Text="Brightness">
                        <MenuFlyoutItem Click="Brightness25MenuItem_Click" Text="25%" />
                        <MenuFlyoutItem Click="Brightness50MenuItem_Click" Text="50%" />
                        <MenuFlyoutItem Click="Brightness100MenuItem_Click" Text="100%" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="Color temperature">
                        <MenuFlyoutItem Click="WarmMenuItem_Click" Text="Warm" />
                        <MenuFlyoutItem Click="NeutralMenuItem_Click" Text="Neutral" />
                        <MenuFlyoutItem Click="CoolMenuItem_Click" Text="Cool" />
                    </MenuFlyoutSubItem>
                    <ToggleMenuFlyoutItem
                        Click="StartWithWindowsMenuItem_Click"
                        IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                        Text="Start with Windows" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="ExitMenuItem_Click" Text="Exit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
