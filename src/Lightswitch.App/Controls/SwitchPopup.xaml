<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lightswitch.App.Controls.SwitchPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Width="160" Height="200" Background="Transparent">
        <Border
            x:Name="Wall"
            Width="160"
            Height="200"
            BorderBrush="#99000000"
            BorderThickness="1"
            CornerRadius="6">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <Grid>
                <Border
                    x:Name="Plate"
                    Width="78"
                    Height="130"
                    Margin="41,35"
                    BorderThickness="1"
                    CornerRadius="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Tapped="Switch_Tapped">
                    <Grid>
                        <Grid
                            x:Name="ScrewTop"
                            Width="9"
                            Height="9"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                            <Ellipse
                                x:Name="ScrewTopDisc"
                                StrokeThickness="0.5" />
                            <Rectangle
                                x:Name="ScrewTopSlot"
                                Width="6"
                                Height="0.5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <Border
                            x:Name="Track"
                            Width="34"
                            Height="68"
                            BorderThickness="1"
                            CornerRadius="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Grid>
                                <Border
                                    x:Name="Arm"
                                    Width="28"
                                    Height="30"
                                    Margin="2,2,0,0"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ArmTransform" />
                                    </Border.RenderTransform>
                                    <Border
                                        x:Name="ArmGrip"
                                        Width="14"
                                        Height="3"
                                        CornerRadius="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid
                            x:Name="ScrewBottom"
                            Width="9"
                            Height="9"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom">
                            <Ellipse
                                x:Name="ScrewBottomDisc"
                                StrokeThickness="0.5" />
                            <Rectangle
                                x:Name="ScrewBottomSlot"
                                Width="6"
                                Height="0.5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
