<Window x:Class="Lightswitch.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Innstillinger"
        Width="420"
        Height="440"
        MinWidth="380"
        MinHeight="400"
        Background="#F8F8F8"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="Innstillinger" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding StatusText, Mode=OneWay}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <CheckBox Grid.Row="1"
                  Margin="0,28,0,0"
                  Content="Power"
                  FontSize="15"
                  IsChecked="{Binding IsOn, Mode=TwoWay}" />

        <StackPanel Grid.Row="2"
                    Margin="0,24,0,0">
            <TextBlock Text="Brightness" />
            <Slider Margin="0,8,0,0"
                    Minimum="0"
                    Maximum="100"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding Brightness, Mode=OneWay, StringFormat={}{0}%}" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Margin="0,24,0,0">
            <TextBlock Text="Color temperature" />
            <Slider Margin="0,8,0,0"
                    Minimum="2700"
                    Maximum="6500"
                    TickFrequency="100"
                    IsSnapToTickEnabled="True"
                    Value="{Binding TemperatureKelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding TemperatureKelvin, Mode=OneWay, StringFormat={}{0} K}" />
        </StackPanel>

        <CheckBox Grid.Row="4"
                  Margin="0,28,0,0"
                  VerticalAlignment="Top"
                  Content="Start with Windows"
                  FontSize="15"
                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
    </Grid>
</Window>
