<Window x:Class="Lightswitch.Wpf.SwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lightswitch"
        Width="160"
        Height="200"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="Root"
          Width="160"
          Height="200"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          SnapsToDevicePixels="True">
        <Grid.ContextMenu>
            <ContextMenu Opened="SwitchContextMenu_Opened">
                <MenuItem Header="Skru av/på"
                          Click="TogglePowerMenuItem_Click" />

                <MenuItem Header="Brightness">
                    <MenuItem Header="25%"
                              Click="Brightness25MenuItem_Click" />
                    <MenuItem Header="50%"
                              Click="Brightness50MenuItem_Click" />
                    <MenuItem Header="75%"
                              Click="Brightness75MenuItem_Click" />
                    <MenuItem Header="100%"
                              Click="Brightness100MenuItem_Click" />
                </MenuItem>

                <MenuItem Header="Color temperature">
                    <MenuItem Header="Warm"
                              Click="WarmTemperatureMenuItem_Click" />
                    <MenuItem Header="Neutral"
                              Click="NeutralTemperatureMenuItem_Click" />
                    <MenuItem Header="Cool"
                              Click="CoolTemperatureMenuItem_Click" />
                </MenuItem>

                <Separator />
                <MenuItem x:Name="StartWithWindowsMenuItem"
                          Header="Start with Windows"
                          IsCheckable="True"
                          Click="StartWithWindowsMenuItem_Click" />
                <MenuItem Header="Innstillinger"
                          Click="SettingsMenuItem_Click" />
                <Separator />
                <MenuItem Header="Avslutt"
                          Click="ExitMenuItem_Click" />
            </ContextMenu>
        </Grid.ContextMenu>
        <Border x:Name="Wall"
                Width="160"
                Height="200"
                SnapsToDevicePixels="True">
            <Grid>
                <Border x:Name="Plate"
                        Width="78"
                        Height="130"
                        Margin="41,35"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MouseLeftButtonUp="Plate_MouseLeftButtonUp"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Border x:Name="PlateFill"
                                Margin="-1"
                                CornerRadius="7" />
                        <Border x:Name="PlateBorder"
                                BorderThickness="1"
                                CornerRadius="6" />

                        <Grid x:Name="ScrewTop"
                              Width="9"
                              Height="9"
                              Margin="0,10,0,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top">
                            <Ellipse x:Name="ScrewTopDisc"
                                     StrokeThickness="0.5" />
                            <Rectangle x:Name="ScrewTopSlot"
                                       Width="6"
                                       Height="0.5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <Border x:Name="Track"
                                Width="34"
                                Height="68"
                                BorderThickness="1"
                                CornerRadius="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Grid>
                                <Border x:Name="Arm"
                                        Width="28"
                                        Height="30"
                                        Margin="2,2,0,0"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ArmTransform" />
                                    </Border.RenderTransform>
                                    <Border x:Name="ArmGrip"
                                            Width="14"
                                            Height="3"
                                            CornerRadius="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid x:Name="ScrewBottom"
                              Width="9"
                              Height="9"
                              Margin="0,0,0,10"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom">
                            <Ellipse x:Name="ScrewBottomDisc"
                                     StrokeThickness="0.5" />
                            <Rectangle x:Name="ScrewBottomSlot"
                                       Width="6"
                                       Height="0.5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
